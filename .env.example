# Development-only settings. Copy to .env; production needs approved private-network values.
INTENT_ENV=development
INTENT_DATABASE_URL=postgresql+psycopg://intent_app:local-app-only@127.0.0.1:54329/intent
INTENT_MIGRATION_DATABASE_URL=postgresql+psycopg://intent_owner:local-owner-only@127.0.0.1:54329/intent
POSTGRES_PASSWORD=local-admin-only
INTENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTENT_ALLOWED_HOSTS=localhost,127.0.0.1
INTENT_MODEL_MODE=fixture
INTENT_ALLOW_DEV_AUTH=true
# Real service values are supplied in the bank environment. No public fallback is configured.
INTENT_MODEL_URL=
INTENT_MODEL_VERSION=
INTENT_IDENTITY_INTROSPECTION_URL=
INTENT_OBJECT_AUTHORIZATION_URL=
INTENT_CONNECTOR_TARGETS_JSON={}
INTENT_CREDENTIALS_JSON={}
INTENT_RESOLVERS_JSON={}
INTENT_WORKSPACE_TIMEZONES_JSON={}
# Server-approved finite catalogs. Console may narrow these grants, never create trust or secrets.
INTENT_INTEGRATIONS_JSON={}
INTENT_MEMBERSHIP_GRANTS_JSON={}
INTENT_WORKSPACE_LIMITS_JSON={}
# Finite publisher-owned A/B/C shadow evaluation; ordinary chat never enables it.
INTENT_ALLOW_SHADOW_EVALUATION=false
